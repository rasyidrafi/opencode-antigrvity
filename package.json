{
  "name": "@rasyid_rafi/opencode-antigravity",
  "version": "0.3.0",
  "description": "OpenCode V2 provider adapter for Google's official Antigravity ACP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rasyidrafi/opencode-antigrvity.git"
  },
  "homepage": "https://github.com/rasyidrafi/opencode-antigrvity#readme",
  "bugs": {
    "url": "https://github.com/rasyidrafi/opencode-antigrvity/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "bun test test",
    "test:live": "OPENCODE_ANTIGRAVITY_ACP_LIVE=1 bun test test/acp-live.test.ts",
    "check": "npm run build && bun test test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@opencode/plugin": "2.0.22",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "antigravity",
    "google-antigravity",
    "anthropic-messages",
    "google"
  ]
}
